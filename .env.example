# Sao chép file này thành .env rồi sửa giá trị:
#   cp .env.example .env
#
# Quy tắc .env:
#   - Không space quanh dấu =   (đúng: KEY=value)
#   - URI / giá trị có ?&@# bọc trong dấu "..."
#
# --- Telegram ---
BOT_TOKEN=your_telegram_bot_token_here
BOT_ADMIN_IDS=

# --- MongoDB (sethome + logs) ---
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME=bot_tools

# --- OpenRouter ---
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_WEBHOOK_SECRET=
# true = gửi prompt/response (nhỏ: Telegram, lớn: MongoDB trace_payloads)
OPENROUTER_INCLUDE_CONTENT=true

# --- Deploy / webhook Telegram ---
WEBHOOK_BASE_URL=https://bot-tools-ebon.vercel.app

# --- Discord (tùy chọn) ---
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here
